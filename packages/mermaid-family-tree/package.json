{
  "name": "mermaid-family-tree",
  "version": "0.1.0",
  "description": "Catmode genetic pedigrees with explicit litters for Mermaid",
  "license": "MIT",
  "type": "module",
  "repository": { "type": "git", "url": "https://github.com/iamthenop/infurnet-mermaid", "directory": "packages/mermaid-family-tree" },
  "engines": { "node": ">=24.22.1 <25" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "LICENSE", "ACKNOWLEDGEMENTS.md", "spec", "examples/fixtures"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "npm run build && tsc -p tsconfig.tests.json",
    "test": "vitest run tests/semantics.spec.ts tests/layout.spec.ts tests/diagram.spec.ts",
    "test:browser": "npm run build && vitest run tests/browser.spec.ts",
    "dev": "npm run build && vite examples/browser --host 127.0.0.1",
    "render:fixtures": "npm run build && node scripts/render-fixtures.mjs"
  },
  "dependencies": { "d3-dag": "1.2.2" },
  "peerDependencies": { "mermaid": "12.2.0" },
  "devDependencies": { "mermaid": "12.2.0", "typescript": "7.0.2", "vite": "8.3.5", "vitest": "5.0.5", "playwright": "1.64.1" }
}
